# Database
POSTGRES_USER=your_postgres_user
POSTGRES_PASSWORD=your_postgres_password
POSTGRES_DB=your_database_name
POSTGRES_HOST=your_database_host
POSTGRES_PORT=5432

DATABASE_URL=postgresql+psycopg://your_postgres_user:your_postgres_password@your_database_host:5432/your_database_name
TEST_DATABASE_URL=postgresql+psycopg://your_postgres_user:your_postgres_password@your_database_host:5432/your_test_database_name

# JWT
SECRET_KEY=your_secret_key
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=60
REFRESH_EXPIRE_DAYS=7

# App
DEBUG=False